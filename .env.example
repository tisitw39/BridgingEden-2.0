# Runtime role. This is the only database URL the deployed app should receive.
DATABASE_URL="postgresql://bridgingeden_app:CHOOSE_AN_APP_PASSWORD@127.0.0.1:5432/bridgingeden?schema=public"

# Owner role, used only by Prisma Migrate in CI or a release job.
# Do not set this on the running app. The owner can disable triggers.
DIRECT_URL="postgresql://bridgingeden_owner:CHOOSE_AN_OWNER_PASSWORD@127.0.0.1:5432/bridgingeden?schema=public"

# Read by docker compose / docker/init.sh and passed to docker/bootstrap-roles.sql.
# Use long random values. The scripts refuse passwords that equal the role names.
BRIDGINGEDEN_OWNER_PASSWORD=
BRIDGINGEDEN_APP_PASSWORD=

# Required in production: a unique secret of at least 32 bytes. Leave this empty in the example.
AUTH_SECRET=
# Public origin. Production requires https. Local development may use http.
AUTH_URL="http://localhost:3000"

# Local demo only. The seed also refuses NODE_ENV=production and any non-demo user.
ALLOW_DEMO_SEED=1
