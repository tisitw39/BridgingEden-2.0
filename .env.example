# Runtime role. Not a superuser, and not the migration owner.
DATABASE_URL="postgresql://bridgingeden_app:bridgingeden_app@127.0.0.1:5432/bridgingeden?schema=public"

# Migration role. Used by Prisma Migrate only. Do not point the app at this URL.
DIRECT_URL="postgresql://bridgingeden_owner:bridgingeden_owner@127.0.0.1:5432/bridgingeden?schema=public"

# Required in production: a unique secret of at least 32 bytes. Leave this empty in the example.
AUTH_SECRET=
# Public origin. Required in production. trustHost is enabled only because this is set.
AUTH_URL="http://localhost:3000"
